[Unit]
Description=Blackout Rugby Tools
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=brt
Group=brt
WorkingDirectory=/opt/brt/current
Environment=BRT_DATA_DIR=/var/lib/brt
Environment=BRT_PUBLIC_URL=https://brt.bordebat.fr
Environment=BRT_SECURE=1
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/brt/venv/bin/uvicorn server.main:app_factory --factory --host 127.0.0.1 --port 3042 --workers 1 --proxy-headers --forwarded-allow-ips 127.0.0.1 --no-access-log
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/brt
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
LockPersonality=true
MemoryMax=512M
TasksMax=64

[Install]
WantedBy=multi-user.target
